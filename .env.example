# Resend — https://resend.com/api-keys
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxx

# Ověřená doména v Resend (pro produkci), např.:
# RESEND_FROM_EMAIL=CTRL Europe <noreply@ctrleurope.com>
# Pro testování lze použít výchozí onboarding@resend.dev (jen na váš Resend účet)
RESEND_FROM_EMAIL="CTRL Europe <onboarding@resend.dev>"

# Kam chodí přihlášky členů
APPLY_TO_EMAIL=ctrleurope@seznam.cz

# Veřejná URL webu (pro logo v e-mailech)
SITE_URL=https://ctrleurope.com

# Veřejná URL webu pro klient (OG tagy, meta)
VITE_SITE_URL=https://ctrleurope.com
