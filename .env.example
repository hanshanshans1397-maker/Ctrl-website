# Resend — https://resend.com/api-keys
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxx

# Ověřená doména v Resend (pro produkci), např.:
# RESEND_FROM_EMAIL=CTRL Europe <noreply@ctrleurope.com>
# Pro testování lze použít výchozí onboarding@resend.dev (jen na váš Resend účet)
RESEND_FROM_EMAIL="CTRL Europe <onboarding@resend.dev>"

# Kam chodí přihlášky členů
APPLY_TO_EMAIL=ctrleurope@seznam.cz

# Veřejná URL webu (pro logo v e-mailech)
SITE_URL=https://ctrleurope.com

# Veřejná URL webu pro klient (OG tagy, meta)
VITE_SITE_URL=https://ctrleurope.com

# Google Apps Script webhook pro registrace na CTRL Run (volitelné — API má dočasnou zálohu v api/lib/env.js)
# RUN_SHEETS_WEBHOOK_URL=https://script.google.com/macros/s/XXXX/exec

# Poznámka: dokud nejsou env na Vercelu, produkce používá dočasné fallbacky v api/lib/env.js
# (Sheets webhook, from email, SITE_URL). RESEND_API_KEY musí zůstat v Environment Variables —
# GitHub push protection ho v kódu nepustí.
